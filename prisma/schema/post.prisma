model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  imageUrl  String?

  isPublished Boolean @default(true)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("posts")
}